# === Site ===
# URL publique (sans slash final). Utilisée dans les e-mails, les liens d’espace prospect,
# les balises canoniques / hreflang et le sitemap. Mettre le domaine définitif (avec ou sans www, selon celui attaché sur Vercel) dès qu’il est en place.
NEXT_PUBLIC_SITE_URL=https://www.visionbds.com

# === Supabase (Dashboard → Project Settings → API) ===
SUPABASE_URL=https://xxxxx.supabase.co
# Clé « service_role » : côté serveur uniquement, ne JAMAIS la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Back-office (/admin) ===
# Mot de passe partagé de l’équipe. Choisissez-le long (20+ caractères).
ADMIN_PASSWORD=
# Secret de signature des sessions (différent du mot de passe). Ex. : openssl rand -base64 32
ADMIN_SESSION_SECRET=

# === E-mails via Resend (https://resend.com) — facultatif mais recommandé ===
RESEND_API_KEY=
# Expéditeur vérifié dans Resend.
EMAIL_FROM=Vision <bonjour@visionbds.com>
# Adresse qui reçoit les nouveaux leads et les demandes de rendez-vous.
AGENCY_NOTIFY_EMAIL=vous@votre-agence.fr

# === Prise de rendez-vous — facultatif ===
# Lien Cal.com ou Calendly de votre créneau « 15 min ». Vide = formulaire interne de demande de créneau.
NEXT_PUBLIC_BOOKING_URL=

# === Générateur de relance de devis (outils gratuits) — facultatif ===
# Clé API Claude (Anthropic), côté serveur uniquement. Facultative : sans elle, le générateur fonctionne
# avec ses modèles (dans le navigateur) et le champ « Qu’a dit le client ? » n’apparaît pas. Avec elle,
# ce champ s’affiche et les messages sont réécrits par Claude à partir des détails saisis.
ANTHROPIC_API_KEY=
